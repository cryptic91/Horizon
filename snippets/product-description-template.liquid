<div class="blm-story-grid">
  <div class="blm-story-grid__intro">
    {% if product.metafields.custom.story_kicker != blank %}
      <span class="blm-eyebrow blominor-product-description__kicker">
        {{ product.metafields.custom.story_kicker }}
      </span>
    {% endif %}

    {% if product.metafields.custom.story_heading != blank %}
      <h3 class="blominor-product-description__heading">
        {{ product.metafields.custom.story_heading }}
      </h3>
    {% endif %}
  </div>

  <div class="blm-story-grid__body">
    {% if product.metafields.custom.story_text != blank %}
      <div class="blominor-product-description__text rte">
        {{ product.metafields.custom.story_text }}
      </div>
    {% endif %}

    {% if product.metafields.custom.materials != blank %}
      <div class="blominor-product-description__materials">
        <h4>Materials & Craft</h4>
        <p>{{ product.metafields.custom.materials }}</p>
      </div>
    {% endif %}

    {% if product.metafields.custom.symbolism != blank %}
      <div class="blominor-product-description__symbolism">
        <h4>Symbolism</h4>
        <p>{{ product.metafields.custom.symbolism }}</p>
      </div>
    {% endif %}

    {% if product.metafields.custom.care_instructions != blank %}
      <div class="blominor-product-description__care">
        <h4>Care Instructions</h4>
        <p>{{ product.metafields.custom.care_instructions }}</p>
      </div>
    {% endif %}
  </div>
</div>
