<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% comment %} Design system foundation {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --color-forest: #4F6656;
        --color-moss: #538666;
        --color-fjord: #73AFA3;
        --color-fjord-blue: #7BBFD8;
        --color-deep-blue: #1A3E6C;
        --color-parchment: #F7F6F2;
        --color-ink: #232724;
        --color-white: #FFFFFF;
        --font-heading: "Cormorant Garamond", "Times New Roman", serif;
        --font-body: "Inter", "Helvetica Neue", Arial, sans-serif;
      }

      body {
        background-color: var(--color-parchment) !important;
        font-family: var(--font-body) !important;
        color: var(--color-ink) !important;
      }

      h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
        font-family: var(--font-heading) !important;
        color: var(--color-deep-blue) !important;
        letter-spacing: -0.01em;
      }

      .button--primary,
      .shopify-payment-button__button--unbranded,
      .product-form__submit {
        background-color: var(--color-forest) !important;
        border-color: var(--color-forest) !important;
        color: var(--color-white) !important;
        border-radius: 2px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.08em !important;
        font-size: 13px !important;
        font-weight: 600 !important;
      }

      .button--primary:hover,
      .shopify-payment-button__button--unbranded:hover,
      .product-form__submit:hover {
        background-color: var(--color-moss) !important;
        border-color: var(--color-moss) !important;
      }

      .announcement-bar,
      .utility-bar {
        background-color: var(--color-deep-blue) !important;
        color: var(--color-parchment) !important;
      }

      .badge,
      .card__badge {
        background-color: var(--color-fjord) !important;
        color: var(--color-white) !important;
        border-radius: 999px !important;
      }

      /* Hero premium treatment */
      .hero__container::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          rgba(26, 62, 108, 0) 0%,
          rgba(26, 62, 108, 0.15) 40%,
          rgba(26, 62, 108, 0.45) 100%
        );
        pointer-events: none;
        z-index: 1;
      }

      .hero__content-wrapper .text-block p,
      .hero__content-wrapper h1,
      .hero__content-wrapper h2 {
        font-family: "Cormorant Garamond", "Times New Roman", serif !important;
        color: #F7F6F2 !important;
        text-shadow: 0 2px 20px rgba(26, 62, 108, 0.3);
        letter-spacing: -0.015em;
        line-height: 1.05;
      }

      .hero__content-wrapper .button--primary,
      .hero__content-wrapper .button-custom {
        background-color: #4F6656 !important;
        border-color: #4F6656 !important;
        color: #FFFFFF !important;
        border-radius: 2px !important;
        padding: 16px 36px !important;
        font-size: 13px !important;
        letter-spacing: 0.12em !important;
        text-transform: uppercase !important;
        box-shadow: 0 8px 30px rgba(79, 102, 86, 0.25);
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }

      .hero__content-wrapper .button--primary:hover,
      .hero__content-wrapper .button-custom:hover {
        background-color: #538666 !important;
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(83, 134, 102, 0.35);
      }

      .hero__media-grid::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
          circle at center,
          transparent 0%,
          transparent 60%,
          rgba(26, 62, 108, 0.12) 100%
        );
        pointer-events: none;
        z-index: 1;
      }

      @media screen and (max-width: 749px) {
        .hero__content-wrapper .text-block p,
        .hero__content-wrapper h1,
        .hero__content-wrapper h2 {
          font-size: clamp(2rem, 8vw, 2.8rem) !important;
        }
        
        .hero__content-wrapper .button--primary,
        .hero__content-wrapper .button-custom {
          padding: 14px 28px !important;
          font-size: 12px !important;
        }
      }

      /* Footer premium treatment */
      footer {
        background-color: #1A3E6C !important;
        color: #F7F6F2 !important;
        padding-top: 64px !important;
        padding-bottom: 48px !important;
      }

      footer a,
      footer .link,
      footer .footer__link {
        color: #F7F6F2 !important;
        text-decoration: none !important;
        transition: color 0.25s ease;
      }

      footer a:hover,
      footer .link:hover,
      footer .footer__link:hover {
        color: #73AFA3 !important;
      }

      footer h2,
      footer h3,
      footer h4,
      footer .footer__heading {
        color: #FFFFFF !important;
        font-family: "Cormorant Garamond", "Times New Roman", serif !important;
        letter-spacing: -0.01em;
        margin-bottom: 20px !important;
      }

      footer .footer__newsletter input,
      footer .newsletter-form__input {
        background-color: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #FFFFFF !important;
        border-radius: 2px !important;
        padding: 14px 16px !important;
      }

      footer .footer__newsletter button,
      footer .newsletter-form__button {
        background-color: #4F6656 !important;
        color: #FFFFFF !important;
        border: none !important;
        border-radius: 2px !important;
        padding: 14px 24px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.08em !important;
        font-size: 13px !important;
        font-weight: 600 !important;
      }

      footer .footer__newsletter button:hover,
      footer .newsletter-form__button:hover {
        background-color: #538666 !important;
      }

      footer .copyright,
      footer .footer__copyright {
        color: rgba(247, 246, 242, 0.7) !important;
        font-size: 13px !important;
        letter-spacing: 0.02em;
      }

      @media screen and (max-width: 749px) {
        footer {
          padding-top: 48px !important;
          padding-bottom: 32px !important;
        }
      }
    </style>

    {{ 'blominor-custom.css' | asset_url | stylesheet_tag: preload: true }}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>