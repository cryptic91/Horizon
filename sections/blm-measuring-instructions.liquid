<div class="blm-measuring-instructions" {{ section.shopify_attributes }}>
  <div class="blm-container blm-measuring-instructions__inner">
    {% if section.settings.heading != blank %}
      <h3 class="blm-measuring-instructions__heading">{{ section.settings.heading }}</h3>
    {% endif %}

    <ol class="blm-measuring-instructions__list">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <li class="blm-measuring-instructions__step" {{ block.shopify_attributes }}>
            <span class="blm-measuring-instructions__number">{{ forloop.index }}</span>
            <span class="blm-measuring-instructions__text">{{ block.settings.text }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Measuring instructions",
  "tag": "section",
  "class": "blm-measuring-instructions-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Measure"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Instruction text",
          "default": "Step instruction goes here."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Measuring instructions"
    }
  ]
}
{% endschema %}
