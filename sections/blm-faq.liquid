<div class="blm-faq" {{ section.shopify_attributes }}>
  <div class="blm-container blm-faq__inner">
    {% if section.settings.heading != blank %}
      <h2 class="blm-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% render 'blm-divider-flourish' %}

    <div class="blm-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <details class="blm-faq__item" {{ block.shopify_attributes }}>
            <summary class="blm-faq__question">
              <span>{{ block.settings.question }}</span>
              <svg class="blm-faq__chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 4.5L7 9.5L12 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="blm-faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "blm-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Frequently Asked"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 25,
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
