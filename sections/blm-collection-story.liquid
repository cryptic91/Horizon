<div
  class="blm-collection-story blm-{{ section.settings.background_variant }}-section{% if section.settings.image != blank %} blm-collection-story--with-image{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="blm-container blm-collection-story__grid">
    {% if section.settings.image != blank %}
      <div class="blm-collection-story__media">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', decoding: 'async', class: 'blm-collection-story__image', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading
        }}
      </div>
    {% endif %}

    <div class="blm-collection-story__content">
      {% if section.settings.heading != blank %}
        <h2 class="blm-collection-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="blm-collection-story__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection story",
  "tag": "section",
  "class": "blm-collection-story-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The story behind this collection"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>A short editorial note about this collection's theme.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional — 1-column centered when blank)"
    },
    {
      "type": "select",
      "id": "background_variant",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "fjord", "label": "Fjord (soft blue)" },
        { "value": "forest", "label": "Forest (dark)" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Collection story"
    }
  ]
}
{% endschema %}
