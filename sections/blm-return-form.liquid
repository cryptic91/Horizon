<div class="blm-return-form" {{ section.shopify_attributes }}>
  <div class="blm-container blm-return-form__inner">
    {% if section.settings.heading != blank %}
      <h2 class="blm-return-form__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <p class="blm-return-form__intro">{{ section.settings.intro }}</p>
    {% endif %}

    {% form 'contact', class: 'blm-return-form__form' %}
      <input type="hidden" name="contact[tags]" value="return-request">

      {% if form.posted_successfully? %}
        <p class="blm-return-form__success">{{ section.settings.success_message }}</p>
      {% else %}
        {% if form.errors %}
          <p class="blm-return-form__error">Please check the form and try again.</p>
        {% endif %}

        <div class="blm-return-form__field">
          <label for="ReturnOrderNumber">Order number</label>
          <input type="text" id="ReturnOrderNumber" name="contact[order_number]" required>
        </div>

        <div class="blm-return-form__field">
          <label for="ReturnEmail">Email address</label>
          <input type="email" id="ReturnEmail" name="contact[email]" required>
        </div>

        <div class="blm-return-form__field">
          <label for="ReturnName">Full name</label>
          <input type="text" id="ReturnName" name="contact[name]" required>
        </div>

        <div class="blm-return-form__field">
          <label for="ReturnReason">Reason for return</label>
          <select id="ReturnReason" name="contact[return_reason]">
            <option value="Doesn't fit">Doesn't fit</option>
            <option value="Not as expected">Not as expected</option>
            <option value="Damaged on arrival">Damaged on arrival</option>
            <option value="Changed my mind">Changed my mind</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="blm-return-form__field">
          <label for="ReturnNotes">Additional notes (optional)</label>
          <textarea id="ReturnNotes" name="contact[body]" rows="5"></textarea>
        </div>

        <button type="submit" class="button button--primary">{{ section.settings.submit_label }}</button>
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Return form",
  "tag": "section",
  "class": "blm-return-form-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Return details"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Tell us a little about your order and we'll be in touch with return instructions."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Request Return Label"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you — we've received your return request and will be in touch within 24 hours."
    }
  ],
  "presets": [
    {
      "name": "Return form"
    }
  ]
}
{% endschema %}
