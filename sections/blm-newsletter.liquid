<div class="blm-newsletter blm-cream-section" {{ section.shopify_attributes }}>
  <div class="blm-container blm-newsletter__inner">
    {% render 'blm-divider-flourish' %}
    {% if section.settings.heading != blank %}
      <h2 class="blm-newsletter__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <p class="blm-newsletter__body">{{ section.settings.body }}</p>
    {% endif %}

    {% form 'customer', class: 'blm-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <p class="blm-newsletter__success">Thank you — you're on the list.</p>
      {% else %}
        <div class="blm-newsletter__row">
          <label for="NewsletterEmail" class="visually-hidden">Email</label>
          <input
            type="email"
            id="NewsletterEmail"
            name="contact[email]"
            placeholder="your@email.com"
            required
          >
          <button type="submit" class="button button--primary">Subscribe</button>
        </div>
        {% if form.errors %}
          <p class="blm-newsletter__error">{{ form.errors.messages['email'] | default: 'Please enter a valid email.' }}</p>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "blm-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in touch"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "Occasional letters from BLÓMINOR — new pieces, quiet stories, no noise."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
