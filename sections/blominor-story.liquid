<section
  class="blominor-story section-spacing {% if section.settings.parchment_background %}blominor-story--parchment{% endif %}"
  style="--blominor-story-padding: {{ section.settings.padding }}px;"
>
  <div class="page-width">
    <div class="blominor-story__grid">
      <div class="blominor-story__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              class: 'blominor-story__image',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {% else %}
          <div class="blominor-story__placeholder">
            <span>Upload Bergfrue or botanical image</span>
          </div>
        {% endif %}
      </div>

      <div class="blominor-story__content">
        {% if section.settings.kicker != blank %}
          <span class="blominor-story__kicker">
            {{ section.settings.kicker }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="blominor-story__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="blominor-story__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="blominor-story__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.quote != blank %}
          <blockquote class="blominor-story__quote">
            <p>“{{ section.settings.quote }}”</p>
            {% if section.settings.quote_author != blank %}
              <cite>{{ section.settings.quote_author }}</cite>
            {% endif %}
          </blockquote>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  .blominor-story {
    padding-top: var(--blominor-story-padding, 80px);
    padding-bottom: var(--blominor-story-padding, 80px);
  }

  .blominor-story--parchment {
    background-color: #F7F6F2;
  }

  .blominor-story__grid {
    display: grid;
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .blominor-story__grid {
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: 56px;
    }
  }

  .blominor-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(26, 62, 108, 0.08);
  }

  .blominor-story__placeholder {
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 32px;
    background: linear-gradient(160deg, rgba(115, 175, 163, 0.2), rgba(79, 102, 86, 0.16));
    color: #1A3E6C;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .blominor-story__kicker {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #538666;
  }

  .blominor-story__heading {
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.1;
    color: #1A3E6C;
    margin: 0 0 20px;
  }

  .blominor-story__text {
    color: #232724;
    font-size: 16px;
    line-height: 1.75;
    max-width: 58ch;
  }

  .blominor-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    padding: 14px 28px;
    background-color: #4F6656;
    color: #FFFFFF;
    border-radius: 3px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background-color 0.25s ease;
  }

  .blominor-story__button:hover {
    background-color: #538666;
    color: #FFFFFF;
  }

  .blominor-story__quote {
    margin: 32px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid rgba(26, 62, 108, 0.12);
  }

  .blominor-story__quote p {
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: 22px;
    line-height: 1.4;
    color: #1A3E6C;
    margin: 0;
  }

  .blominor-story__quote cite {
    display: block;
    margin-top: 10px;
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #538666;
  }
{% endstyle %}

{% schema %}
{
  "name": "BLÓMINOR Story",
  "tag": "section",
  "class": "blominor-story-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Nordic botanical heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Bergfrue Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The Bergfrue flower grows where few things can. It became our first symbol: resilience, softness, and beauty carried through hard seasons.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "Inspired by Norway. Made to be lived in."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author",
      "default": "BLÓMINOR NORWAY"
    },
    {
      "type": "checkbox",
      "id": "parchment_background",
      "label": "Use parchment background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "BLÓMINOR Story"
    }
  ]
}
{% endschema %}