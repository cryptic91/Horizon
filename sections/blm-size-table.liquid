<div class="blm-size-table" {{ section.shopify_attributes }}>
  <div class="blm-container blm-size-table__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="blm-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="blm-size-table__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="blm-size-table__intro rte">{{ section.settings.intro }}</div>
    {% endif %}

    <div class="blm-size-table__scroll">
      <table class="blm-size-table__table">
        <caption class="visually-hidden">{{ section.settings.heading }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_1_label }}</th>
            <th scope="col">{{ section.settings.col_2_label }}</th>
            <th scope="col">{{ section.settings.col_3_label }}</th>
            <th scope="col">{{ section.settings.col_4_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'size_row' %}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.name }}</th>
                <td>
                  {% if block.settings.status == 'pending' %}
                    <em class="blm-size-table__pending">{{ block.settings.col_1 }}</em>
                  {% else %}
                    {{ block.settings.col_1 }}
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.status == 'pending' %}
                    <em class="blm-size-table__pending">{{ block.settings.col_2 }}</em>
                  {% else %}
                    {{ block.settings.col_2 }}
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.status == 'pending' %}
                    <em class="blm-size-table__pending">{{ block.settings.col_3 }}</em>
                  {% else %}
                    {{ block.settings.col_3 }}
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Size table",
  "tag": "section",
  "class": "blm-size-table-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size Table"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "header",
      "content": "Column headers"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Name column label",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Column 2 label"
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Column 3 label"
    },
    {
      "type": "text",
      "id": "col_4_label",
      "label": "Column 4 label"
    }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Size row",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Row name",
          "default": "Size name"
        },
        {
          "type": "text",
          "id": "col_1",
          "label": "Column 1 value"
        },
        {
          "type": "text",
          "id": "col_2",
          "label": "Column 2 value"
        },
        {
          "type": "text",
          "id": "col_3",
          "label": "Column 3 value"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "available", "label": "Available" },
            { "value": "confirmed", "label": "Confirmed" },
            { "value": "pending", "label": "Pending" }
          ],
          "default": "available"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Size table"
    }
  ]
}
{% endschema %}
